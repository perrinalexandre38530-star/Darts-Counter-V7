# MULTISPORTS SCORING — frontend environment template
# Copy this file to .env locally only for overrides/secrets.
# Les IDs AdMob publics de référence vivent dans config/admob.public.json.
# NEVER commit the real .env file.

# Supabase public frontend configuration
VITE_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR_SUPABASE_PUBLISHABLE_OR_ANON_KEY

# Public ONLINE provider
VITE_ONLINE_PROVIDER=supabase
VITE_ONLINE_WS_BASE_URL=

# Optional scanner endpoint
VITE_DART_SCANNER_ENDPOINT=

# Founder-only private NAS bridge
# Keep disabled for normal public users.
VITE_NAS_DATA_SYNC=false
VITE_NAS_API_URL=

# Google AdMob Android
# Modes:
# - google_test : IDs de démonstration Google, aucun revenu (défaut)
# - real_test   : vrais IDs AdMob sur téléphone(s) déclaré(s) comme appareil(s) de test
# - production  : vrais IDs AdMob, aucune configuration de test injectée
VITE_ADMOB_MODE=google_test
# Compatibilité ancienne configuration : 1 = google_test, 0 = production.
VITE_ADMOB_TEST_MODE=1

VITE_ADMOB_ANDROID_APP_ID=
VITE_ADMOB_ANDROID_BANNER_ID=
VITE_ADMOB_ANDROID_INTERSTITIAL_ID=
VITE_ADMOB_ANDROID_REWARDED_ID=

# Optionnel mais recommandé : un bloc bannière distinct par emplacement afin
# d'analyser séparément les performances dans AdMob. Sans valeur, le bloc
# générique VITE_ADMOB_ANDROID_BANNER_ID est utilisé.
VITE_ADMOB_ANDROID_BANNER_HOME_ID=
VITE_ADMOB_ANDROID_BANNER_HOME_SECONDARY_ID=
VITE_ADMOB_ANDROID_BANNER_MESSAGES_ID=
VITE_ADMOB_ANDROID_BANNER_PROFILES_ID=
VITE_ADMOB_ANDROID_BANNER_GAMES_ID=
VITE_ADMOB_ANDROID_BANNER_COMPETITIONS_ID=
VITE_ADMOB_ANDROID_BANNER_ONLINE_ID=
VITE_ADMOB_ANDROID_BANNER_STATS_ID=
VITE_ADMOB_ANDROID_BANNER_HISTORY_ID=
VITE_ADMOB_ANDROID_BANNER_SETTINGS_ID=
VITE_ADMOB_ANDROID_BANNER_SCREENS_ID=

# Modes google_test / real_test. IDs séparés par virgule/point-virgule/espace.
# Requis pour forcer la géographie UMP sur un téléphone physique et obligatoire en real_test.
# Récupère l'ID dans Logcat après une première requête AdMob.
VITE_ADMOB_ANDROID_TEST_DEVICE_IDS=
# true si les appareils de test sont enregistrés directement dans la console AdMob.
VITE_ADMOB_TEST_DEVICES_MANAGED_BY_CONSOLE=true
# DISABLED, EEA ou NOT_EEA. Actif uniquement dans un mode de test.
VITE_ADMOB_CONSENT_DEBUG_GEOGRAPHY=DISABLED

# Génération du fichier public/app-ads.txt. Le publisher ID est public et ne
# doit pas être préfixé par VITE_. Exemples acceptés : pub-1234567890123456 ou
# 1234567890123456. Il peut aussi être déduit de l'App ID.
ADMOB_PUBLISHER_ID=
ADMOB_APP_ADS_EXTRA_LINES=

# -----------------------------------------------------------------------------
# Cloudflare Pages Functions — STOCKAGE R2 PREMIUM (SERVER-SIDE ONLY)
# NE JAMAIS préfixer ces secrets par VITE_. Ils se configurent dans Pages.
# -----------------------------------------------------------------------------
# STRIPE_SECRET_KEY=sk_test_...
# STRIPE_WEBHOOK_SECRET_STORAGE=whsec_...
# STRIPE_PRICE_STORAGE_STARTER_MONTHLY=price_...
# STRIPE_PRICE_STORAGE_STARTER_YEARLY=price_...
# STRIPE_PRICE_STORAGE_PLAYER_MONTHLY=price_...
# STRIPE_PRICE_STORAGE_PLAYER_YEARLY=price_...
# STRIPE_PRICE_STORAGE_PLUS_MONTHLY=price_...
# STRIPE_PRICE_STORAGE_PLUS_YEARLY=price_...
# STRIPE_PRICE_STORAGE_PRO_MONTHLY=price_...
# STRIPE_PRICE_STORAGE_PRO_YEARLY=price_...
# STRIPE_PRICE_STORAGE_CLUB_MONTHLY=price_...
# STRIPE_PRICE_STORAGE_CLUB_YEARLY=price_...
# STRIPE_PRICE_STORAGE_TITAN_MONTHLY=price_...
# STRIPE_PRICE_STORAGE_TITAN_YEARLY=price_...
# Webhook Stripe : https://<ton-domaine-pages>/api/storage/backups/billing/webhook

