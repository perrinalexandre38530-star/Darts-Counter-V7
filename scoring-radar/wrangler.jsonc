{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "multisports-scoring-radar",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-25",
  "compatibility_flags": ["nodejs_compat"],
  "ai": {
    "binding": "AI"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "scoring-radar-db",
      "database_id": "6e48bf0b-efac-4c96-a322-6bb69eb6e358"
    }
  ],
  "queues": {
    "producers": [
      {
        "binding": "CANDIDATE_QUEUE",
        "queue": "scoring-radar-candidates"
      }
    ],
    "consumers": [
      {
        "queue": "scoring-radar-candidates",
        "max_batch_size": 20,
        "max_batch_timeout": 2,
        "max_retries": 3,
        "dead_letter_queue": "scoring-radar-candidates-dlq"
      }
    ]
  },
  "triggers": {
    "crons": ["0 * * * *"]
  },
  "vars": {
    "APP_DESTINATION_URL": "https://multisports-scoring.pages.dev/",
    "RADAR_MARKETS": "fr:FR,en:US,en:GB,es:ES,de:DE,it:IT,pt:PT,pt:BR,nl:NL,pl:PL,tr:TR,ar:SA,hi:IN,id:ID,ja:JP,ko:KR,zh-hans:SG,zh-hant:TW,ru:RU,uk:UA,sv:SE,da:DK,no:NO,fi:FI,cs:CZ,ro:RO,el:GR,he:IL,th:TH,vi:VN,hu:HU,bg:BG,hr:HR,sk:SK,sl:SI,et:EE,lv:LV,lt:LT,sr:RS,ms:MY,bn:BD,ta:IN,te:IN,gu:IN,mr:IN,pa:IN,kn:IN,ml:IN,is:IS,ca:ES,eu:ES,gl:ES",
    "RADAR_MARKETS_PER_RUN": "1",
    "RADAR_RESULTS_PER_QUERY": "10",
    "RADAR_MIN_SCORE": "70",
    "RADAR_TRANSLATION_TIMEOUT_MS": "15000",
    "RADAR_BRAVE_TIMEOUT_MS": "15000",
    "RADAR_CLASSIFY_TIMEOUT_MS": "30000",
    "RADAR_STALL_TIMEOUT_MS": "60000",
    "SOCIAL_AI_TIMEOUT_MS": "30000",
    "SOCIAL_AUTOPILOT_MODE": "review",
    "SOCIAL_MIN_OPPORTUNITY_SCORE": "85",
    "SOCIAL_MIN_QUALITY_SCORE": "90",
    "SOCIAL_MIN_FACTUAL_SCORE": "95",
    "SOCIAL_MIN_VISUAL_SCORE": "90",
    "SOCIAL_MAX_SPAM_RISK": "10",
    "SOCIAL_MAX_CRINGE_RISK": "10",
    "SOCIAL_MAX_CAMPAIGNS_PER_DAY": "2"
  },
  "observability": {
    "enabled": true,
    "logs": {
      "head_sampling_rate": 1
    }
  }
}
