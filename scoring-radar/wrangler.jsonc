{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "multisports-scoring-radar",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-24",
  "compatibility_flags": ["nodejs_compat"],
  "ai": {
    "binding": "AI"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "scoring-radar-db",
      "database_id": "REPLACE_WITH_D1_DATABASE_ID"
    }
  ],
  "queues": {
    "producers": [
      {
        "binding": "CANDIDATE_QUEUE",
        "queue": "scoring-radar-candidates"
      }
    ],
    "consumers": [
      {
        "queue": "scoring-radar-candidates",
        "max_batch_size": 20,
        "max_batch_timeout": 10,
        "max_retries": 3,
        "dead_letter_queue": "scoring-radar-candidates-dlq"
      }
    ]
  },
  "triggers": {
    "crons": ["*/5 * * * *"]
  },
  "vars": {
    "APP_DESTINATION_URL": "https://darts-counter-v7.pages.dev/",
    "RADAR_MARKETS": "fr:FR,en:US,en:GB,es:ES,de:DE,it:IT,pt:PT,pt:BR,nl:NL,pl:PL,tr:TR,ar:SA,hi:IN,id:ID,ja:JP,ko:KR,zh-hans:SG",
    "RADAR_MARKETS_PER_RUN": "3",
    "RADAR_RESULTS_PER_QUERY": "10",
    "RADAR_MIN_SCORE": "70"
  },
  "observability": {
    "enabled": true,
    "logs": {
      "head_sampling_rate": 1
    }
  }
}
