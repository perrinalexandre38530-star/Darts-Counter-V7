{
  "name": "@multisports-scoring/scoring-radar",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "types": "wrangler types",
    "typecheck": "npm run types && tsc -p tsconfig.json --noEmit",
    "db:local": "wrangler d1 execute scoring-radar-db --local --file=schema.sql",
    "db:remote": "wrangler d1 execute scoring-radar-db --remote --file=schema.sql"
  },
  "devDependencies": {
    "typescript": "~5.9.3",
    "wrangler": "^4.50.0"
  }
}
