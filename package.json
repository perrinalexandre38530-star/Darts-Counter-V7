{
  "name": "darts-counter-v5",
  "private": true,
  "version": "5.3.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "lint": "eslint .",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "deploy:online": "wrangler deploy --config wrangler.online.toml",
    "test:auth": "node ./src/tools/test-auth-spine.mjs",
    "test:x01v3": "node ./tools/run-ts-regressions.mjs --only tools/test-x01v3-regression.ts",
    "test:sync": "node ./tools/test-cloud-sync.mjs",
    "test:ci": "npm run typecheck && npm run build && npm run test:auth && npm run test:sync && npm run test:cloud-routing && npm run test:nearby && npm run test:regressions && npm run test:monetization && npm run test:android-bootstrap && npm run test:admob-native && npm run test:play-billing",
    "compress-images": "node ./src/tools/compress-images.js",
    "switch-to-webp": "node ./src/tools/replace-imports-to-webp.mjs",
    "test:territories-maps": "node ./src/tools/audit-territories-maps.mjs",
    "test:territories-value": "node ./tools/run-ts-regressions.mjs --only src/tools/test-territories-value-win.ts",
    "test:territories-unique": "node ./tools/run-ts-regressions.mjs --only src/tools/test-territories-unique-values.ts",
    "deploy:pages": "npm run build && wrangler pages deploy dist --project-name darts-counter-v7",
    "test:r2-backups": "node --experimental-strip-types ./tools/test-direct-r2-backups.mjs",
    "test:storage": "npm run test:r2-backups && node ./tools/test-storage-destinations.mjs",
    "test:monetization": "node ./tools/test-monetization-regression.mjs",
    "android:bootstrap": "node ./tools/bootstrap-android-capacitor.mjs",
    "android:sync": "npm run build && npx cap sync android",
    "android:open": "npx cap open android",
    "android:doctor": "npx cap doctor",
    "test:android-bootstrap": "node ./tools/test-android-bootstrap.mjs",
    "test:admob-native": "node ./tools/test-admob-native.mjs",
    "android:configure-admob": "node ./tools/configure-android-admob.mjs",
    "android:configure-play": "node ./tools/configure-android-play-billing.mjs",
    "android:release-check": "node ./tools/android-release-check.mjs",
    "test:play-billing": "node ./tools/test-play-billing.mjs",
    "test:nearby": "node ./tools/test-public-nearby.mjs",
    "test:cloud-routing": "node ./tools/test-cloud-public-contracts.mjs",
    "test:nearby:live": "node ./tools/test-supabase-public-live.mjs",
    "test:live": "npm run test:nearby:live",
    "test:baseball": "node ./tools/run-ts-regressions.mjs --only tools/test-baseball-regression.ts",
    "test:shooter": "node ./tools/run-ts-regressions.mjs --only tools/test-shooter-regression.ts",
    "test:loterie": "node ./tools/run-ts-regressions.mjs --only tools/test-loterie-regression.ts",
    "test:linked-history": "node ./tools/run-ts-regressions.mjs --only tools/test-linked-profile-history.ts",
    "test:regressions": "node ./tools/run-ts-regressions.mjs",
    "test:auto": "npm run test:ci",
    "test:release": "npm run test:auto && npm run test:live",
    "test:r2-account-data": "node ./tools/test-r2-account-data.mjs"
  },
  "dependencies": {
    "@capacitor-community/admob": "^8.0.0",
    "@capacitor/android": "^8.4.2",
    "@capacitor/core": "^8.4.2",
    "@supabase/supabase-js": "^2.48.0",
    "fflate": "^0.8.2",
    "jsqr": "^1.4.0",
    "lz-string": "^1.5.0",
    "nanoid": "^5.1.6",
    "qrcode": "^1.5.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.30.3",
    "recharts": "^3.3.0",
    "stripe": "^22.1.1",
    "zustand": "^5.0.9"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.4.2",
    "@eslint/js": "^9.38.0",
    "@types/node": "^24.8.1",
    "@types/react": "^18.3.11",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^5.0.4",
    "eslint": "^9.38.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.24",
    "glob": "^11.0.3",
    "globals": "^16.4.0",
    "sharp": "^0.33.5",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.46.1",
    "vite": "^7.1.10",
    "wrangler": "^4.50.0"
  }
}
