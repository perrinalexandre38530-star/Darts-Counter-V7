{
  "name": "darts-counter-v5",
  "private": true,
  "version": "1.0.0-rc13",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "lint": "eslint .",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "deploy:online": "wrangler deploy --config wrangler.online.toml",
    "test:auth": "node ./src/tools/test-auth-spine.mjs",
    "test:x01v3": "node ./tools/run-ts-regressions.mjs --only tools/test-x01v3-regression.ts",
    "test:sync": "node ./tools/test-cloud-sync.mjs",
    "test:ci": "npm run version:check && npm run typecheck && npm run build && npm run test:auth && npm run test:sync && npm run test:cloud-routing && npm run test:nearby && npm run test:regressions && npm run test:monetization && npm run test:android-bootstrap && npm run test:android-store-v1 && npm run test:account-restore && npm run test:admob-native && npm run test:play-billing && npm run test:play-privacy",
    "compress-images": "node ./src/tools/compress-images.js",
    "switch-to-webp": "node ./src/tools/replace-imports-to-webp.mjs",
    "test:territories-maps": "node ./src/tools/audit-territories-maps.mjs",
    "test:territories-value": "node ./tools/run-ts-regressions.mjs --only src/tools/test-territories-value-win.ts",
    "test:territories-unique": "node ./tools/run-ts-regressions.mjs --only src/tools/test-territories-unique-values.ts",
    "deploy:pages": "npm run build && wrangler pages deploy dist --project-name multisports-scoring",
    "test:r2-backups": "node --experimental-strip-types ./tools/test-direct-r2-backups.mjs",
    "test:storage": "npm run test:r2-backups && node ./tools/test-storage-destinations.mjs",
    "test:monetization": "node ./tools/test-monetization-regression.mjs",
    "android:bootstrap": "node ./tools/bootstrap-android-capacitor.mjs",
    "android:sync": "npm run version:sync && npm run build && npx cap sync android && npm run android:configure-awena-translation && npm run android:configure-admob && npm run android:configure-play && npm run admob:release-check && npm run android:release-check && npm run version:check",
    "android:open": "npx cap open android",
    "android:doctor": "npx cap doctor",
    "test:android-bootstrap": "node ./tools/test-android-bootstrap.mjs",
    "test:admob-native": "node ./tools/test-admob-native.mjs && node ./tools/test-admob-live-banners.mjs && node ./tools/test-admob-fullscreen-v76.mjs && node ./tools/test-admob-diagnostics-v78.mjs && node ./tools/test-admob-rewarded-pass-v79.mjs && node ./tools/test-admob-release-gate-v80.mjs",
    "android:configure-admob": "node ./tools/configure-android-admob.mjs",
    "android:configure-play": "node ./tools/configure-android-play-billing.mjs",
    "android:release-check": "node ./tools/android-release-check.mjs",
    "test:play-billing": "node ./tools/test-play-billing.mjs",
    "test:nearby": "node ./tools/test-public-nearby.mjs",
    "test:cloud-routing": "node ./tools/test-cloud-public-contracts.mjs",
    "test:nearby:live": "node ./tools/test-supabase-public-live.mjs",
    "test:live": "npm run test:nearby:live",
    "test:baseball": "node ./tools/run-ts-regressions.mjs --only tools/test-baseball-regression.ts",
    "test:shooter": "node ./tools/run-ts-regressions.mjs --only tools/test-shooter-regression.ts",
    "test:loterie": "node ./tools/run-ts-regressions.mjs --only tools/test-loterie-regression.ts",
    "test:firefighter": "node ./tools/test-darts-firefighter-integration.mjs && node ./tools/run-ts-regressions.mjs --only tools/test-darts-firefighter-regression.ts",
    "test:poker": "node ./tools/test-darts-poker-integration.mjs && node --experimental-strip-types ./tools/test-darts-poker-regression.ts",
    "test:linked-history": "node ./tools/run-ts-regressions.mjs --only tools/test-linked-profile-history.ts",
    "test:regressions": "node ./tools/run-ts-regressions.mjs",
    "test:auto": "npm run test:ci",
    "test:release": "npm run test:auto && npm run test:live",
    "test:r2-account-data": "node ./tools/test-r2-account-data.mjs",
    "test:history-integrity": "node --experimental-strip-types ./tools/test-history-integrity-regression.ts && node ./tools/test-history-snapshot-integrity-contract.mjs",
    "android:run": "npm run android:sync && npx cap run android --no-sync",
    "android:build:debug": "npm run android:sync && node ./tools/run-android-gradle.mjs assembleDebug",
    "test:android-store-v1": "node ./tools/test-android-store-v1.mjs",
    "android:play:signing-check": "node ./tools/check-android-play-signing.mjs",
    "android:bundle:release": "npm run android:sync && npm run android:play:signing-check && node ./tools/run-android-gradle.mjs bundleRelease",
    "android:play:verify-aab": "node ./tools/verify-android-aab.mjs",
    "android:play:aab": "npm run version:check && npm run typecheck && npm run test:android-store-v1 && npm run test:admob-native && npm run test:play-billing && npm run test:android-jdk && npm run android:bundle:release && npm run android:play:verify-aab",
    "android:version": "node ./tools/set-android-version.mjs",
    "test:account-restore": "node ./tools/test-android-account-restore.mjs",
    "test:play-privacy": "node ./tools/test-play-privacy.mjs",
    "test:interstitial-every-match": "node ./tools/test-interstitial-every-match.mjs",
    "version:sync": "node ./tools/sync-release-version.mjs",
    "version:check": "node ./tools/check-release-version.mjs",
    "test:cargo": "node tools/test-cargo-integration.mjs && node --experimental-strip-types tools/test-cargo-regression.ts",
    "test:ocean-control": "node tools/test-ocean-control-integration.mjs && node ./tools/run-ts-regressions.mjs --only tools/test-ocean-control-regression.ts",
    "test:football": "node tools/test-football-integration.mjs && node --experimental-strip-types tools/test-football-regression.ts && node --experimental-strip-types tools/test-football-codec.ts",
    "android:jdk:check": "node ./tools/android-java-runtime.mjs",
    "test:android-jdk": "node ./tools/test-android-java-runtime.mjs",
    "android:configure-awena-translation": "node ./tools/configure-android-awena-translation.mjs",
    "test:monetization-free-lock": "node ./tools/test-monetization-free-lock-v75.mjs",
    "test:admob-fullscreen": "node ./tools/test-admob-fullscreen-v76.mjs",
    "test:admob-diagnostics": "node ./tools/test-admob-diagnostics-v78.mjs",
    "test:awena:v84": "node ./tools/test-awena-v84-expert-reference.mjs && node ./tools/test-awena-v83-max-knowledge.mjs",
    "test:awena:v85": "node ./tools/test-awena-v85-omni-knowledge.mjs && npm run test:awena:v84",
    "test:awena:v86": "node ./tools/test-awena-v86-voice-ultra.mjs && npm run test:awena:v85",
    "test:awena:v87": "node tools/test-awena-v87-procedural-academy.mjs",
    "test:awena:v88": "node tools/test-awena-v88-guide-pro.mjs",
    "test:awena:v89": "node tools/test-awena-v89-master-knowledge.mjs",
    "test:admob-rewarded-pass": "node ./tools/test-admob-rewarded-pass-v79.mjs",
    "test:awena:v90": "node tools/test-awena-v90-expert-companion.mjs",
    "admob:release-check": "node ./tools/admob-release-check.mjs",
    "admob:fullscreen:check": "node ./tools/admob-release-check.mjs --require-fullscreen",
    "admob:fullscreen:set": "node ./tools/set-admob-fullscreen-ids.mjs",
    "test:admob-release-gate": "node ./tools/test-admob-release-gate-v80.mjs",
    "test:awena:v92": "node tools/test-awena-v92-user-guide.mjs",
    "test:awena:v93": "node tools/test-awena-v93-mode-precision.mjs",
    "test:awena:v931": "node tools/test-awena-v931-killer-config.mjs && npm run test:awena:v93",
    "test:social-auth": "node ./tools/test-social-auth-integration.mjs"
  },
  "dependencies": {
    "@capacitor-community/admob": "^8.0.0",
    "@capacitor/android": "^8.4.2",
    "@capacitor/core": "^8.4.2",
    "@supabase/supabase-js": "^2.48.0",
    "fflate": "^0.8.2",
    "jsqr": "^1.4.0",
    "lz-string": "^1.5.0",
    "nanoid": "^5.1.6",
    "qrcode": "^1.5.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.30.3",
    "recharts": "^3.3.0",
    "stripe": "^22.1.1",
    "zustand": "^5.0.9"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.4.2",
    "@eslint/js": "^9.38.0",
    "@types/node": "^24.8.1",
    "@types/react": "^18.3.11",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^5.0.4",
    "eslint": "^9.38.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.24",
    "glob": "^11.0.3",
    "globals": "^16.4.0",
    "sharp": "^0.33.5",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.46.1",
    "vite": "^7.1.10",
    "wrangler": "^4.50.0",
    "esbuild": "^0.27.3"
  }
}
